DATABASE_URL="postgres://user:password@host:5432/dbname"
SESSION_SECRET="troque-por-uma-string-aleatoria-bem-longa"

# Pluggy (extrato bancário) — credenciais da aplicação em dashboard.pluggy.ai.
# Só no servidor: nunca prefixar com NEXT_PUBLIC_.
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# Protege /api/cron/pluggy. A Vercel envia esse valor sozinha no header
# Authorization quando a variável existe no projeto. Sem ela, o cron é recusado.
CRON_SECRET=""
